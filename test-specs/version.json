[
  {
    "name": "version_success",
    "description": "Should successfully retrieve version information",
    "input": {
      "baseURL": "https://proxmox.example.com",
      "apiToken": "test-token",
      "uuid": "test-uuid"
    },
    "mock": {
      "statusCode": 200,
      "body": {
        "version": "8.0.3",
        "release": "8.0",
        "repoid": "abc123def456"
      }
    },
    "expected": {
      "version": "8.0.3",
      "release": "8.0",
      "repoid": "abc123def456"
    }
  },
  {
    "name": "version_different_version",
    "description": "Should handle different version formats",
    "input": {
      "baseURL": "https://proxmox.example.com",
      "apiToken": "test-token",
      "uuid": "test-uuid"
    },
    "mock": {
      "statusCode": 200,
      "body": {
        "version": "7.4.2",
        "release": "7.4",
        "repoid": "xyz789"
      }
    },
    "expected": {
      "version": "7.4.2",
      "release": "7.4",
      "repoid": "xyz789"
    }
  },
  {
    "name": "version_retry_success",
    "description": "Should retry on failure and succeed on third attempt",
    "input": {
      "baseURL": "https://proxmox.example.com",
      "apiToken": "test-token",
      "uuid": "test-uuid-retry"
    },
    "mock": {
      "retries": [
        { "attempt": 1, "statusCode": 500 },
        { "attempt": 2, "statusCode": 503 },
        {
          "attempt": 3,
          "statusCode": 200,
          "body": {
            "version": "8.0.3",
            "release": "8.0",
            "repoid": "abc123"
          }
        }
      ]
    },
    "expected": {
      "version": "8.0.3",
      "release": "8.0",
      "repoid": "abc123"
    },
    "expectedAttempts": 3
  },
  {
    "name": "version_all_retries_fail",
    "description": "Should fail after all retry attempts exhausted",
    "input": {
      "baseURL": "https://proxmox.example.com",
      "apiToken": "test-token",
      "uuid": "test-uuid-fail"
    },
    "mock": {
      "retries": [
        { "attempt": 1, "statusCode": 500 },
        { "attempt": 2, "statusCode": 500 },
        { "attempt": 3, "statusCode": 500 },
        { "attempt": 4, "statusCode": 500 }
      ]
    },
    "expectError": true,
    "errorContains": "test-uuid-fail"
  },
  {
    "name": "version_unauthorized",
    "description": "Should handle 401 unauthorized errors",
    "input": {
      "baseURL": "https://proxmox.example.com",
      "apiToken": "invalid-token",
      "uuid": "test-uuid-unauth"
    },
    "mock": {
      "statusCode": 401,
      "body": {
        "error": "authentication failed"
      }
    },
    "expectError": true,
    "errorContains": "401"
  }
]
